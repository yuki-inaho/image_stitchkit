@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PNG)
find_dependency(JPEG)
find_dependency(Threads)
if(@STITCHKIT_ENABLE_CUDA@)
  find_dependency(CUDAToolkit)
endif()
if(@STITCHKIT_ENABLE_LINEAE@)
  find_dependency(onnxruntime CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/stitchkitTargets.cmake")
check_required_components(stitchkit)
